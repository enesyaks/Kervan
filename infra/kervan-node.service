[Unit]
Description=Kervan node (runs agents for a Kervan hub)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=kervan
Group=kervan
WorkingDirectory=/opt/kervan/server
# KERVAN_HUB_URL=ws://kervan:7420, KERVAN_NODE_TOKEN=<the hub's>, optional KERVAN_NODE_NAME
EnvironmentFile=/etc/kervan/node.env
Environment=KERVAN_WORKSPACES_DIR=/srv/kervan/workspaces
ExecStart=/usr/bin/node src/node-main.ts
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
# Same hardening as the hub; /home/kervan keeps the agent CLIs' login state.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/kervan /home/kervan

[Install]
WantedBy=multi-user.target
